# brain_mirror.env -- config for brain_mirror.py, on node2.
#
# Copy to brain_mirror.env (same directory) and fill in the <placeholders>.
# brain_mirror.env is GITIGNORED: real addresses live only on node2, never in
# the public repo. brain_mirror.py REFUSES to run while MAIN_HOST or BRAIN_DEST
# is unset or still a <placeholder>.
#
# Plain KEY=VALUE lines; no shell expansion except a leading ~ in paths.

# ---- the training host (read-only: nothing is ever written there) ---------
MAIN_HOST=<training-host-LAN-IP>
# The login account. Must be able to READ everything under MAIN_ROOT.
MAIN_USER=<training-host-user>
MAIN_SSH_PORT=22
# Private key on node2 whose public half is in MAIN_USER's authorized_keys.
MAIN_SSH_KEYFILE=~/.ssh/skybot_brain_mirror_ed25519
MAIN_ROOT=/workspace/devai

# ---- where the brain lands on node2 (the hard drive, not the boot SSD) -----
BRAIN_DEST=<node2-hdd-path>/skybot-brain

# ---- retention -------------------------------------------------------------
# last N five-minute snapshots, + newest per hour for H hours, + newest per
# day for D days. Unchanged files are hardlinks, so a quiet brain costs ~0.
KEEP_LAST=12
KEEP_HOURLY_HOURS=48
KEEP_DAILY_DAYS=14
# Below this much free space on BRAIN_DEST: prune oldest first; still short ->
# skip the pull with a loud error. Never fills the disk.
MIN_FREE_GB=20

# ---- optional --------------------------------------------------------------
# 1 = also keep ONE rolling copy of runlogs/foundation_shadow/ in
# BRAIN_DEST/shadow_mirror/ (append-only logs; not per snapshot).
INCLUDE_SHADOW=0
# Space-separated paths relative to MAIN_ROOT (trailing / = directory) to use
# INSTEAD of the built-in list -- only if configs/minecraft_skybot.yaml moves
# loop.log_dir, break_memory_path or skill_bank.storage_dir.
#BRAIN_PATHS=
# How rsync is started on main: idle CPU + idle IO priority.
#RSYNC_PATH=nice -n 19 ionice -c3 rsync
# Consistency: re-pulls if a checkpoint save lands mid-copy; seconds to wait
# before the "did anything change?" dry run.
#MAX_REPULLS=3
#SETTLE_S=3
# Identical verification failures in a row before a corrupt-on-main file is
# accepted as DEGRADED instead of freezing the mirror forever.
#DEGRADED_AFTER=3
#RSYNC_TIMEOUT_S=1800
#IO_TIMEOUT_S=300
# --status reports STALE (exit 16) when the newest snapshot is older than this.
#STALE_MINUTES=20
