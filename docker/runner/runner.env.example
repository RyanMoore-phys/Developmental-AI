# Copy to `.env` — THE NAME MATTERS — and edit. It is gitignored; it holds no
# secrets in the credential sense, but it is host-specific and must not be
# committed.
#
#   cp runner.env.example .env && chmod 600 .env
#
# WHY `.env` AND NOT `runner.env`: docker-compose.yml mounts the SSH key via
# `${MAIN_SSH_KEY_HOST_PATH}`, and `${...}` interpolation is resolved at PARSE
# time from the shell or from a file named exactly `.env`. An `env_file:`
# entry does NOT feed interpolation — it only sets variables inside the
# running container. Name this file anything else and every compose command,
# including `down -v`, fails with "required variable MAIN_SSH_KEY_HOST_PATH is
# missing" while the value sits plainly in the file.
# (If you must keep another name: `docker compose --env-file <name> ...`.)

# ---- GitHub registration -------------------------------------------------
GITHUB_URL=https://github.com/<your-org>/<your-repo>
# REGISTRATION token from Settings -> Actions -> Runners -> New self-hosted
# runner. Copy only the string after `--token`. It expires in ~1 hour and is
# single-use — needed at first `up`, and again if you ever wipe the volumes.
RUNNER_NAME=skybot-mini
RUNNER_LABELS=skybot,linux

# --- PICK ONE OF THESE TWO ------------------------------------------------
#
# (a) RECOMMENDED — mint registration tokens automatically.
# A registration token is SINGLE-USE and expires in ~1 hour, and `down -v`,
# a rebuild, a reboot or a power cut all force a fresh registration. Doing
# that by hand every time fails with an unhelpful
#     api.github.com/actions/runner-registration : 404
# which looks like a bad URL rather than a dead token.
#
# Create at github.com/settings/personal-access-tokens -> Fine-grained token:
#     Repository access : only <your-org>/<your-repo>
#     Permissions       : Administration -> Read and write   (that one only)
# TRADE-OFF, stated plainly: this is a long-lived credential at rest on this
# host, where before there was only a short-lived single-use one. Keep the
# file chmod 600, and use a FINE-GRAINED token — a classic `repo` token would
# grant far more than runner administration.
#GITHUB_PAT=github_pat_...
#
# (b) MANUAL — one-shot token, re-pasted on every re-registration.
# Settings -> Actions -> Runners -> New self-hosted runner; copy only the
# string after `--token`.
RUNNER_TOKEN=

# ---- Where the training host SSH key lives ON THIS HOST ----------------------------
# Mounted read-only into the container. Absolute path; no ~ expansion here.
MAIN_SSH_KEY_HOST_PATH=/home/YOURUSER/.ssh/skybot_ed25519

# ---- Connection values the workflows read --------------------------------
MAIN_HOST=CHANGE_ME   # the training host's LAN IP. Never commit the real value.
# ROTATES ON EVERY TRAINING HOST RESTART. A job failing at preflight with an ssh error
# almost always means this is stale. Update, then `docker compose up -d` to
# recreate the container so it picks the new value up.
MAIN_SSH_PORT=22
# Login account on the training host. Non-root needs PASSWORDLESS SUDO there.
MAIN_USER=skybot
# Path INSIDE the container — must match the mount target in docker-compose.yml.
MAIN_SSH_KEYFILE=/home/runner/.ssh/skybot_ed25519

# Needed by: host.yml / pipeline.yml action=connect
MC_SERVER_TS_IP=CHANGE_ME   # the Paper server's address. Never commit it.

# ---- Optional -----------------------------------------------------------
# Use Tailscale SSH instead of plain ssh (stable name, no port to maintain).
# Requires the tailnet ACL rule in docs/CI_SETUP.md and a tailscale CLI in the
# image, which this Dockerfile does not install by default.
#DEPLOY_TRANSPORT=tailscale
