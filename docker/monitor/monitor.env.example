# Copy to `.env` — THE NAME MATTERS — and edit.
#
#   cp monitor.env.example .env && chmod 600 .env
#
# WHY `.env` AND NOT `monitor.env`: docker-compose.yml mounts the SSH key via
# ${POD_SSH_KEY_HOST_PATH}, and ${...} interpolation is resolved at PARSE time
# from the shell or from a file named exactly `.env`. An `env_file:` entry
# does NOT feed interpolation — it only sets variables inside the container.
# Name this anything else and every compose command fails with "required
# variable is missing" while the value sits plainly in the file.

# ---- the pod (source of truth) ------------------------------------------
POD_HOST=<redacted-host>
# ROTATES ON EVERY POD RESTART. If the collector logs ssh failures, this is
# almost always why. Edit, then `docker compose up -d` (restart alone does
# NOT re-read this file).
POD_SSH_PORT=19983
# Absolute path ON THIS HOST; no ~ expansion. Docker silently creates a
# DIRECTORY if the path does not exist, which then fails as a permissions
# error rather than anything informative.
POD_SSH_KEY_HOST_PATH=/home/YOURUSER/.ssh/skybot_ed25519
REMOTE_PATH=/workspace/devai/podlogs/metrics.jsonl
# Seconds between rsync backfills. The tail is live; this only closes gaps
# left by a dropped connection.
RSYNC_EVERY=300

# ---- the Paper server (independent cross-check) --------------------------
# Reached over the tailnet from this host. Thin by design — one server-list
# ping; see server_poll.py for why this is a falsifier, not a collector.
MC_HOST=100.64.0.11
MC_PORT=25565
MC_PROTOCOL=754
POLL_SECONDS=30

# ---- dashboard -----------------------------------------------------------
GRAFANA_PASSWORD=changeme
